      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Task fields and generated ID\", () => { const data=pm.response.json(); pm.expect(Object.keys(data).sort()).to.eql([\"completed\",\"id\",\"title\"]); pm.expect(data.title).to.eql(\"Owner task\"); pm.expect(data.completed).to.eql(false); pm.expect(Number.isInteger(data.id) && data.id > 0).to.eql(true); pm.collectionVariables.set(\"task_a_id\", String(data.id)); pm.collectionVariables.set(\"task_a_snapshot\",JSON.stringify(data)); });"
            ]
          }
        }
      ]
    },
