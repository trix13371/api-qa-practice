              "pm.test(\"PATCH changes persist in response\", () => { const data=pm.response.json(); pm.expect(data).to.eql({id:Number(pm.collectionVariables.get(\"task_a_id\")),title:\"Owner task completed\",completed:true}); pm.collectionVariables.set(\"task_a_snapshot\",JSON.stringify(data)); });"
            ]
          }
        }
      ]
    },
