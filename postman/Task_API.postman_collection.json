{
  "info": {
    "name": "Task API - reproducible two-user regression",
    "description": "Educational local-only HTTP regression. Run the WHOLE collection in order, starting with 01. A fresh username pair is generated per iteration; task IDs and tokens come from responses. Runtime tokens must never be exported or shared. Scenarios cover CRUD, rejected PATCH atomicity, owner isolation, filtering, authentication and logout. A CLI runner supplies a temporary SQLite database and free local port. This is not commercial experience or exhaustive security testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_a}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Local_training_123!",
      "type": "string"
    },
    {
      "key": "username_a",
      "value": "",
      "type": "string"
    },
    {
      "key": "username_b",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_a",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_b",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_a_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_b_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_a_snapshot",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_b_snapshot",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.replaceIn(\"{{base_url}}\");",
          "if (!/^http:\\/\\/(127\\.0\\.0\\.1|localhost)(:\\d+)?$/.test(base)) {",
          "    pm.execution.setNextRequest(null);",
          "    pm.test(\"Target is an allowed local training server\", () => pm.expect.fail(\"Use http://127.0.0.1 or http://localhost without a path\"));",
          "    pm.execution.skipRequest();",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Request ID is UUID\", () => {",
          "    pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
          "});",
          "pm.test(\"Sensitive responses are not cached\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
          "if (pm.response.code === 204) {",
          "    pm.test(\"204 response is empty\", () => pm.expect(pm.response.text()).to.eql(\"\"));",
          "} else {",
          "    pm.test(\"Response is JSON\", () => {",
          "        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
          "        pm.response.json();",
          "    });",
          "}",
          "if (pm.response.code >= 400) {",
          "    pm.test(\"Error is structured\", () => pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health and fresh test data",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 24);",
              "pm.collectionVariables.set(\"username_a\", \"qa_a_\" + suffix);",
              "pm.collectionVariables.set(\"username_b\", \"qa_b_\" + suffix);",
              "[\"token_a\", \"token_b\", \"task_a_id\", \"task_b_id\", \"task_a_snapshot\", \"task_b_snapshot\"].forEach(k => pm.collectionVariables.set(k, \"\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Service healthy\", () => { pm.expect(pm.response.json()).to.eql({status:\"ok\"}); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register user A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username_a}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Registered user without password\", () => { const data = pm.response.json(); pm.expect(data.username).to.eql(pm.collectionVariables.get(\"username_a\")); pm.expect(Number.isInteger(data.id) && data.id > 0).to.eql(true); pm.expect(Object.keys(data).sort()).to.eql([\"id\",\"username\"]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login user A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username_a}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Bearer session returned\", () => { const data=pm.response.json(); pm.expect(data.token_type).to.eql(\"Bearer\"); pm.expect(data.expires_in).to.eql(3600); pm.expect(data.access_token).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"token_a\", data.access_token); });"
            ]
          }
        }
      ]
    },
